-      glDrawArrays(GL_TRIANGLE_FAN, 0, 4);
+      /* leandros: a strip, not a fan. ANGLE on Vulkan passes fans through,
+       * and MoltenVK (Metal has no fans) draws only the first triangle of
+       * one, so every shader blit filled half its rectangle. Same quad,
+       * vertex order 0 1 3 2. */
+      struct blit_coord strip[4] = {
+         blit_ctx->vertices[0], blit_ctx->vertices[1],
+         blit_ctx->vertices[3], blit_ctx->vertices[2]
+      };
+      glBufferData(GL_ARRAY_BUFFER, sizeof(strip), strip, GL_STATIC_DRAW);
+      glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
    }
 
