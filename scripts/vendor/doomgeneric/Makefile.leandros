# Vendored copy of ../doomgeneric/Makefile.leandros.
#
# doomgeneric is a shared, non-git sibling checkout: EVERY worktree of this
# repo on a machine resolves `../doomgeneric` to the SAME physical directory
# (they all share `~/code/` as parent), and the checkout carries no history of
# its own to diff against or merge. build-all.sh's build_doom() copies this
# file over the sibling's Makefile.leandros whenever it differs, so a fix made
# here reaches every worktree AND every machine (Mac, desktop, laptop) the
# next time each one runs build-all.sh, instead of only the one sibling
# checkout someone happened to hand-edit.
#
# If you change how doomgeneric builds, edit this file (not the sibling
# directly) and keep it in sync with what upstream doomgeneric/Makefile.leandros
# should look like; the sibling is regenerated from this, not the other way
# around.
#
# History: originally the sibling ran a single OBJDIR ($(ARCH)) and `make
# clean` was invoked from build-all.sh before every build. Two worktrees
# building concurrently (or even the same worktree building both arches back
# to back with a `clean` in between) raced on those shared .o files and on the
# final `doom-$(ARCH)` binary that scripts/mkfs-f2fs-populated.py reads from
# this same fixed relative path. See artifacts/notes/lane-pollout-2026-09-18.md
# item 2 and artifacts/notes/lane-buildobj-2026-09-24.md for the fix.

CC = clang

UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
    # On macOS, we use rust-lld from the rust toolchain as a fallback for ld.lld
    LD_PATH := $(shell find $$(rustc --print sysroot) -name rust-lld | head -n 1)
    LD = $(LD_PATH) -flavor gnu
else
    LD = ld.lld
endif

LEANDROS_ROOT ?= $(abspath ../leandros)

ARCH ?= x86_64

ifeq ($(ARCH),x86_64)
    TARGET = x86_64-unknown-none
    CFLAGS_ARCH = -m64
    LDFLAGS_ARCH =
else ifeq ($(ARCH),aarch64)
    TARGET = aarch64-unknown-none
    CFLAGS_ARCH =
    LDFLAGS_ARCH =
endif

CFLAGS = --target=$(TARGET) -I. -Iinclude -static -fno-stack-protector -ffreestanding -nostdlib -O2 $(CFLAGS_ARCH)
LDFLAGS = -static -nostdlib $(LDFLAGS_ARCH)

LIBC = $(LEANDROS_ROOT)/userland/target/$(TARGET)/release/libleandros_libc.a

# Select DRM, SDL, or legacy framebuffer version
USE_SDL ?= 1
USE_DRM ?= 1

ifeq ($(USE_SDL),1)
    PLATFORM_SRC = doomgeneric_sdl.c leandros_sdl.c leandros_midi.c
    CFLAGS += -DUSE_SDL=1 -DFEATURE_SOUND=1 -DLEANDROS=1 -DGM_USE_MMAP=1
else ifeq ($(USE_DRM),1)
    PLATFORM_SRC = doomgeneric_leandros_drm.c
    CFLAGS += -DUSE_DRM=1
else
    PLATFORM_SRC = doomgeneric_leandros.c
endif

SRCS = am_map.c d_event.c d_items.c d_iwad.c d_loop.c d_main.c d_mode.c d_net.c \
       doomdef.c doomgeneric.c $(PLATFORM_SRC) doomstat.c dstrings.c \
       f_finale.c f_wipe.c g_game.c hu_lib.c hu_stuff.c info.c \
       i_cdmus.c i_endoom.c i_input.c i_joystick.c i_scale.c i_sdlsound.c i_sdlmusic.c i_sound.c i_system.c \
       memio.c mus2mid.c \
       i_timer.c i_video.c m_argv.c m_bbox.c m_cheat.c m_config.c m_controls.c \
       m_fixed.c m_menu.c m_misc.c m_random.c p_ceilng.c p_doors.c p_enemy.c \
       p_floor.c p_inter.c p_lights.c p_map.c p_maputl.c p_mobj.c p_plats.c \
       p_pspr.c p_saveg.c p_setup.c p_sight.c p_spec.c p_switch.c p_telept.c \
       p_tick.c p_user.c r_bsp.c r_data.c r_draw.c r_main.c r_plane.c r_segs.c \
       r_sky.c r_things.c sounds.c s_sound.c st_lib.c st_stuff.c tables.c \
       v_video.c w_wad.c z_zone.c w_main.c w_file_leandros.c leandros_stubs.c

# OBJDIR isolates one build's .o files from every other concurrent build in
# this same shared, non-git sibling directory. build-all.sh passes a value
# unique per worktree+arch (derived from the calling LEANDROS_ROOT), so two
# worktrees — or two arches of the same worktree — never read or clobber each
# other's .o files. The bare default ($(ARCH)) only matters for a manual,
# interactive `make` invoked directly in this directory, where there is
# exactly one build in flight at a time.
OBJDIR ?= $(ARCH)

OBJS = $(addprefix $(OBJDIR)/, $(SRCS:.c=.o))

# The final binary name/location is NOT namespaced per worktree: it is a
# fixed, shared relative path (doom-$(ARCH)) that
# scripts/mkfs-f2fs-populated.py reads regardless of which worktree produced
# it. Two builds for the SAME arch from different worktrees still serialize on
# this one file — that is inherent to the shared final-output contract, not
# something OBJDIR isolation can fix — but the link step below never leaves a
# reader able to see a half-written binary: it links to a private per-process
# temp name first, then renames onto the real name (mv is atomic on the same
# filesystem), so the worst case is "picked up whichever build finished its
# link last," never a torn/truncated file.
DOOM_BIN = doom-$(ARCH)

all: $(DOOM_BIN)

drm:
	$(MAKE) USE_DRM=1

legacy:
	$(MAKE) USE_DRM=0

$(OBJDIR)/%.o: %.c
	@mkdir -p $(OBJDIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/leandros_midi.o: leandros_midi.h third_party/tinysoundfont/tsf.h
$(OBJDIR)/leandros_sdl.o: leandros_midi.h include/SDL_mixer.h
$(OBJDIR)/i_sdlmusic.o: include/SDL_mixer.h

$(DOOM_BIN): $(OBJS)
	$(LD) $(LDFLAGS) -o $@.tmp.$$$$ $(OBJS) $(LIBC) && mv -f $@.tmp.$$$$ $@

# Scoped to the current OBJDIR/ARCH only — never wipes another worktree's or
# another arch's in-flight object directory or finished binary. build-all.sh
# no longer calls this (per-worktree OBJDIR isolation makes it unnecessary:
# within one worktree the doomgeneric source never changes mid-build, so an
# incremental rebuild is always safe and strictly faster); it remains for
# manual use.
clean:
	rm -rf $(OBJDIR) $(DOOM_BIN)
