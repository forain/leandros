target/
**/*.swp
.DS_Store
*.img
*.vdi
*.cpio.gz
*.o
*.cpio
log
*.snippet

# QEMU UEFI NVRAM variable stores: regenerated by run-qemu.sh and rewritten by
# UEFI on every boot. Machine-local runtime state, not source.
aarch64_vars.fd
x86_64_vars.fd
.!*!*

# Downloaded RPi firmware blobs (start4.elf, fixup4.dat), cached by
# prepare-rpi5-sdcard.sh on first run. Third-party binaries, not source.
.rpi-firmware-cache/

# Python bytecode caches from the build/test helper scripts
__pycache__/
*.pyc

# Ad-hoc f2fs image backups made by hand during debugging sessions, not source.
f2fs-data0-*.img.*

# Port build scratch directories.
ports/*/.work/
