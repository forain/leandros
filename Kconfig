# LeandrOS kernel configuration. Edit with ./scripts/menuconfig.sh
#
# Naming convention: CONFIG_FOO_BAR=y  <->  cargo feature "drv-foo-bar" of the
# kernel crate (scripts/kconfig/to-cargo.py). A feature is passed to cargo only
# if kernel/Cargo.toml declares it, so symbols may exist before they are wired.
mainmenu "LeandrOS Kernel Configuration"

config ARCH_X86_64
	def_bool "$(ARCH)" = "x86_64"

config ARCH_ARM64
	def_bool "$(ARCH)" = "aarch64"

choice
	prompt "Board"
	default BOARD_QEMU

config BOARD_QEMU
	bool "QEMU / generic PC (no board feature)"

config BOARD_RPI5
	bool "Raspberry Pi 5 (BCM2712 + RP1)"
	depends on ARCH_ARM64

config BOARD_RASPI4B
	bool "QEMU -M raspi4b (testing stepping stone)"
	depends on ARCH_ARM64

endchoice

config MODULES
	bool "Loadable module support"
	option modules
	default n
	help
	  Allow drivers marked tristate to be built as loadable modules (=m).
	  Modules are built by scripts/kmod/kmod-build.sh and loaded from the
	  initrd or with finit_module(). Leave unset for an all-built-in kernel.

config PCI
	def_bool y

config USB
	bool "USB support"
	default y

config USB_VIDEO_CLASS
	tristate "USB Video Class webcams (uvc)"
	depends on USB
	default y
	help
	  The UVC class driver and its /dev/video0 camera. =m builds modules/uvc, loaded by the
	  `usb 0e 02` alias when the enumerator meets a video-streaming interface.

config NET
	def_bool y

config DRM
	def_bool y

config WIFI_STACK
	bool
	help
	  Shared wifi_* stack (selected by Wi-Fi drivers).

config NVIDIA
	bool "NVIDIA GPUs via OpenRM (needs ports/openrm build; ./build-all.sh --nvidia)"
	depends on ARCH_X86_64
	default n

config KVM
	bool "KVM host support (EL2/VHE; /dev/kvm in later lanes)"
	depends on ARCH_ARM64
	default n
	help
	  Keep the kernel at EL2 with VHE (HCR_EL2.E2H=TGE=1) instead of
	  dropping to EL1 at boot. Off: every entry path drops to EL1 exactly
	  as before. Cargo feature drv-kvm.

source "drivers/Kconfig"
