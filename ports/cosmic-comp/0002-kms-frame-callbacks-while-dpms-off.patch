 impl SurfaceThreadState {
+    fn start_dpms_off_frames(&mut self) {
+        if self.dpms_off_frames.is_some() {
+            return;
+        }
+        // Surfaces whose primary scan-out output is this one get a callback per tick; others
+        // are throttled by smithay to the same ~1 s (`send_frames`' THROTTLE).
+        const DPMS_OFF_FRAME_INTERVAL: Duration = Duration::from_millis(995);
+        let token = self
+            .loop_handle
+            .insert_source(
+                Timer::from_duration(DPMS_OFF_FRAME_INTERVAL),
+                |_, _, state| {
+                    state.frame_callback_seq = state.frame_callback_seq.wrapping_add(1);
+                    state.send_frame_callbacks();
+                    TimeoutAction::ToDuration(DPMS_OFF_FRAME_INTERVAL)
+                },
+            )
+            .expect("Failed to schedule DPMS-off frame callbacks");
+        self.dpms_off_frames = Some(token);
+    }
+
+    fn stop_dpms_off_frames(&mut self) {
+        if let Some(token) = self.dpms_off_frames.take() {
+            self.loop_handle.remove(token);
+        }
+    }
