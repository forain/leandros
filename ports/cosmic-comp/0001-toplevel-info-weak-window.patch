 use tracing::error;
 
 pub trait Window: IsAlive + Clone + PartialEq + Send {
+    /// A non-owning reference to the window. Protocol handles hold this, so a
+    /// handle the client never destroys cannot keep a closed window (and its
+    /// surface, textures and buffer imports) alive. See Smithay#1562.
+    type Weak: Clone + Send;
+    fn downgrade(&self) -> Self::Weak;
+    fn upgrade(weak: &Self::Weak) -> Option<Self>;
+
     fn title(&self) -> String;
     fn app_id(&self) -> String;
     fn is_activated(&self) -> bool;
@@ -102,7 +109,7 @@ pub struct ToplevelHandleStateInner<W: Window> {
     title: String,
     app_id: String,
     states: Option<Vec<States>>,
-    pub(super) window: Option<W>,
+    pub(super) window: Option<W::Weak>,
 }
 pub type ToplevelHandleState<W> = Mutex<ToplevelHandleStateInner<W>>;
 
@@ -116,7 +123,7 @@ impl<W: Window> ToplevelHandleStateInner<W> {
             title: String::new(),
             app_id: String::new(),
             states: None,
-            window: Some(window.clone()),
+            window: Some(window.downgrade()),
         })
     }
 
@@ -669,7 +676,7 @@ where
 pub fn window_from_handle<W: Window + 'static>(handle: ZcosmicToplevelHandleV1) -> Option<W> {
