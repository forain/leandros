+    /// Tell the caller of an undeliverable method call that the service is not
+    /// there, instead of dropping the call and leaving the caller blocked.
+    ///
+    /// Without this, a method call addressed to a well-known name that nobody
+    /// owns is simply discarded: `send_msg` bails and `serve_peer` turns that
+    /// into a `warn!`. Nothing goes back to the caller, and there is no
+    /// server-side reply timeout here the way the reference dbus-daemon has
+    /// one, nor a client-side one in zbus, so a blocking caller waits forever.
+    ///
+    /// The reply is gated three ways, all load-bearing:
+    ///
+    ///   * only a `MethodCall` is answered. A reply or an error addressed to a
+    ///     name that has since gone away must be dropped silently, or the bus
+    ///     would answer its own errors; signals never reach here at all, since
+    ///     `serve_peer` routes them to `broadcast_msg` first.
+    ///   * `NO_REPLY_EXPECTED` suppresses it, per the D-Bus specification.
+    ///     Replying to a call that asked for no reply leaves an unmatched
+    ///     serial in the caller.
+    ///   * a message with no `sender` is dropped, because there is nowhere to
+    ///     address the error. `peer::Stream` sets the sender on everything it
+    ///     admits, so this is belt and braces.
+    async fn reply_service_unknown(&self, msg: &Message, name: &WellKnownName<'_>) {
+        let header = msg.header();
+
+        if msg.message_type() != message::Type::MethodCall {
+            return;
+        }
+        if header
+            .primary()
+            .flags()
+            .contains(message::Flags::NoReplyExpected)
+        {
+            return;
+        }
+        let Some(sender) = header.sender().cloned() else {
+            return;
+        };
+
+        // `Message::error` copies the incoming serial into `reply_serial` and
+        // the incoming sender into `destination` by itself; only the sender
+        // field has to be filled in, and it has to be the bus's own name.
+        let reply = match Message::error(&header, "org.freedesktop.DBus.Error.ServiceUnknown")
+            .and_then(|b| b.sender(fdo::BUS_NAME))
+            .and_then(|b| {
+                b.build(&(format!(
+                    "The name {name} was not provided by any .service files"
+                ),))
+            }) {
+            Ok(reply) => reply,
+            Err(e) => {
+                warn!("Couldn't build a ServiceUnknown reply for `{name}`: {e}");
+
+                return;
+            }
+        };
+
+        if let Err(e) = self.send_msg_to_unique_name(reply, sender).await {
+            warn!("Couldn't deliver the ServiceUnknown reply for `{name}`: {e}");
+        }
+    }
