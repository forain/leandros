+//! LeandrOS: optional per-message traffic census.
+//!
+//! Off by default and free when off (one relaxed load per routed message).
+//! Turned on at run time by creating `$XDG_RUNTIME_DIR/busd-stats.on` (checked
+//! every `PERIOD`); while it exists, every `PERIOD` busd rewrites
+//! `$XDG_RUNTIME_DIR/busd-stats` with the messages routed in that period:
+//! one line per (type, sender, destination, interface.member) with the message
+//! count and the number of deliveries it cost (a signal is delivered to every
+//! connection whose match rules accept it).
+//! Removing the `.on` file turns it off again.
+
+use std::{
+    collections::HashMap,
+    fmt::Write as _,
+    path::PathBuf,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Mutex,
+    },
+    time::{Duration, Instant},
+};
+
+use zbus::{message, Message};
+
+const PERIOD: Duration = Duration::from_secs(5);
+
+static ON: AtomicBool = AtomicBool::new(false);
+static TABLE: Mutex<Option<HashMap<String, [u64; 2]>>> = Mutex::new(None);
+
+#[inline]
+pub fn enabled() -> bool {
+    ON.load(Ordering::Relaxed)
+}
+
+/// Count one routed message that cost `deliveries` sends.
+pub fn note(msg: &Message, deliveries: u64) {
+    if !enabled() {
+        return;
+    }
+    let h = msg.header();
+    let ty = match msg.message_type() {
+        message::Type::MethodCall => "call",
+        message::Type::MethodReturn => "return",
+        message::Type::Error => "error",
+        message::Type::Signal => "signal",
+    };
+    let mut key = String::with_capacity(96);
+    let _ = write!(
+        key,
+        "{} {} {} {}.{}",
+        ty,
+        h.sender().map(|s| s.as_str()).unwrap_or("-"),
+        h.destination().map(|d| d.as_str()).unwrap_or("*"),
+        h.interface().map(|i| i.as_str()).unwrap_or("-"),
+        h.member().map(|m| m.as_str()).unwrap_or("-"),
+    );
+    let mut t = TABLE.lock().unwrap();
+    let e = t.get_or_insert_with(HashMap::new).entry(key).or_insert([0, 0]);
+    e[0] += 1;
+    e[1] += deliveries;
+}
+
+fn dir() -> PathBuf {
+    PathBuf::from(std::env::var_os("XDG_RUNTIME_DIR").unwrap_or_else(|| "/tmp".into()))
+}
+
+/// The periodic knob check and dump; spawn once.
+pub async fn run() {
+    let mut since = Instant::now();
+    loop {
+        tokio::time::sleep(PERIOD).await;
+        let on = dir().join("busd-stats.on").exists();
+        let was = ON.swap(on, Ordering::Relaxed);
+        let rows = TABLE.lock().unwrap().take();
+        let secs = since.elapsed().as_secs_f64();
+        since = Instant::now();
+        if !on || !was {
+            continue;
+        }
+        let mut rows: Vec<(String, [u64; 2])> = rows.unwrap_or_default().into_iter().collect();
+        rows.sort_by(|a, b| b.1[1].cmp(&a.1[1]).then(b.1[0].cmp(&a.1[0])));
+        let (msgs, deliv) = rows
+            .iter()
+            .fold((0u64, 0u64), |(m, d), r| (m + r.1[0], d + r.1[1]));
+        let mut s = String::new();
+        let _ = writeln!(
+            s,
+            "# busd stats over {secs:.1}s: {msgs} messages, {deliv} deliveries"
+        );
+        let _ = writeln!(s, "# messages deliveries type sender destination interface.member");
+        for (k, [m, d]) in &rows {
+            let _ = writeln!(s, "{m} {d} {k}");
+        }
+        let _ = std::fs::write(dir().join("busd-stats"), s);
+    }
+}
