+            .unwrap_or(true);
+        if !first {
+            return self.await_name_owner(name, ACTIVATION_TIMEOUT).await;
+        }
+        let result = self.spawn_service(name, &service).await;
+        if let Ok(mut set) = self.activating.lock() {
+            set.remove(name.as_str());
+        }
+        result
+    }
