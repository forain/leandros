+//! Integration tests for D-Bus service activation (`Peers::load_servicedirs`
+//! / `Peers::activate_service`).
+//!
+//! These exercise `Peers` directly (rather than a full `Bus` + client, the
+//! way `tests/fdo.rs`/`tests/greet.rs` do) because a genuine positive-path
+//! test -- a spawned process that actually calls `Hello`/`RequestName` and
+//! gets observed by `await_name_owner` -- would need a second, D-Bus-aware
+//! helper binary that this crate doesn't otherwise build. What's tested
+//! here instead is the real wiring around that gap: directory scanning,
+//! the fast/no-spawn path for non-activatable names (the property
+//! `send_msg`'s implicit-activation hook depends on to stay safe), a
+//! failed spawn, and a spawn that succeeds but never claims its name.
+//!
+//! These run on the host (`cargo test`), not on a LeandrOS image -- see
+//! `Exec=/usr/bin/touch ...` below, which relies on a host `touch(1)`.
+
+use std::{env::temp_dir, fs, time::Duration};
+
+use busd::{bus::Bus, peers::Peers};
+use enumflags2::BitFlag;
+use ntest::timeout;
+use rand::{
+    distr::{Alphanumeric, SampleString},
+    rng,
+};
+use tokio::{select, sync::mpsc::channel};
+use zbus::{
+    connection,
+    fdo::{self, DBusProxy, RequestNameFlags},
+    names::WellKnownName,
+    proxy::CacheProperties,
+};
+
+/// `tests/greet.rs`/`tests/fdo.rs` each call `busd::tracing_subscriber::init()`
+/// unconditionally, which is safe there because every `[[test]]` binary
+/// runs in its own process. This file has two tests that both need
+/// logging (`activation_end_to_end_over_dbus`,
+/// `implicit_activation_spawns_and_eventually_replies_on_timeout`), and
+/// the default test harness runs them as parallel threads in the *same*
+/// process, so a second unconditional `init()` panics
+/// ("global default trace dispatcher has already been set"). Guard with
+/// `Once` instead.
+fn init_tracing() {
+    static INIT: std::sync::Once = std::sync::Once::new();
+    INIT.call_once(busd::tracing_subscriber::init);
+}
+
+fn temp_servicedir() -> std::path::PathBuf {
+    let s = Alphanumeric.sample_string(&mut rng(), 10);
+    let dir = temp_dir().join(format!("busd-activation-test-{s}"));
+    fs::create_dir_all(&dir).unwrap();
+    dir
+}
+
+#[tokio::test]
+#[timeout(15000)]
+async fn activate_service_unknown_name_is_fast_and_exact() {
+    let peers = Peers::new();
+    let name: WellKnownName = "org.example.NoSuchService".try_into().unwrap();
+
+    let start = std::time::Instant::now();
+    let err = peers.activate_service(&name).await.unwrap_err();
+    // No `.service` file exists for this name, so this must return
+    // immediately -- no spawn attempt, no `ACTIVATION_TIMEOUT` wait. This
+    // is exactly the property `send_msg`'s implicit-activation hook
+    // relies on: the non-activatable path (the overwhelming majority of
+    // unowned-name calls) must stay as fast as it was before activation
+    // existed, or it risks reintroducing the hang
+    // `service-unknown-reply.patch` fixed.
+    assert!(
+        start.elapsed() < Duration::from_millis(500),
+        "activation of an unknown name must not spawn or wait"
+    );
+    assert!(matches!(err, zbus::fdo::Error::ServiceUnknown(_)));
+}
+
+#[tokio::test]
+#[timeout(15000)]
+async fn activate_service_bad_exec_fails_immediately() {
+    let dir = temp_servicedir();
+    fs::write(
+        dir.join("org.example.BadExec.service"),
+        "[D-BUS Service]\nName=org.example.BadExec\n\
+         Exec=/no/such/binary/exists-really-does-not\n",
+    )
+    .unwrap();
+
+    let peers = Peers::new();
+    peers.load_servicedirs(&[dir.clone()]).await;
+
+    let name: WellKnownName = "org.example.BadExec".try_into().unwrap();
+    let start = std::time::Instant::now();
+    let err = peers.activate_service(&name).await.unwrap_err();
+    assert!(
+        start.elapsed() < Duration::from_millis(500),
+        "a spawn() failure (ENOENT) must be reported immediately, not after the activation timeout"
+    );
+    assert!(matches!(err, zbus::fdo::Error::SpawnExecFailed(_)));
+
+    fs::remove_dir_all(&dir).unwrap();
+}
+
+#[tokio::test]
+#[timeout(15000)]
+async fn activate_service_spawns_but_never_claims_name_times_out() {
+    let dir = temp_servicedir();
+    let marker = dir.join("spawned.marker");
+    // A real, spawnable program that exits immediately without ever
+    // touching D-Bus. This proves the `Exec=` line actually ran (the
+    // marker file appears) while still exercising the "spawned but never
+    // claimed the name" timeout path, without needing a D-Bus-aware
+    // helper binary.
+    fs::write(
+        dir.join("org.example.NeverClaims.service"),
+        format!(
+            "[D-BUS Service]\nName=org.example.NeverClaims\nExec=/usr/bin/touch {}\n",
+            marker.display()
+        ),
+    )
+    .unwrap();
+
+    let peers = Peers::new();
+    peers.load_servicedirs(&[dir.clone()]).await;
+
+    assert!(
+        peers
+            .activatable_names()
+            .await
+            .iter()
+            .any(|n| n.as_str() == "org.example.NeverClaims"),
+        "expected the scanned service to be activatable"
+    );
+
+    let name: WellKnownName = "org.example.NeverClaims".try_into().unwrap();
+    let err = peers.activate_service(&name).await.unwrap_err();
+    assert!(matches!(err, zbus::fdo::Error::SpawnChildExited(_)));
+    assert!(
+        marker.exists(),
+        "expected the Exec= program to have actually run"
+    );
+
+    fs::remove_dir_all(&dir).unwrap();
+}
+
+#[tokio::test]
+#[timeout(15000)]
+async fn load_servicedirs_first_definition_wins_on_duplicate_name() {
+    let dir_a = temp_servicedir();
+    let dir_b = temp_servicedir();
+    fs::write(
+        dir_a.join("org.example.Dup.service"),
+        "[D-BUS Service]\nName=org.example.Dup\nExec=/usr/bin/true-from-a\n",
+    )
+    .unwrap();
+    fs::write(
+        dir_b.join("org.example.Dup.service"),
+        "[D-BUS Service]\nName=org.example.Dup\nExec=/usr/bin/true-from-b\n",
+    )
+    .unwrap();
+
+    let peers = Peers::new();
+    // `dir_a` before `dir_b`: the first definition (`dir_a`'s) must win,
+    // matching the reference `dbus-daemon`'s servicedir precedence.
+    peers.load_servicedirs(&[dir_a.clone(), dir_b.clone()]).await;
+
+    let name: WellKnownName = "org.example.Dup".try_into().unwrap();
+    let err = peers.activate_service(&name).await.unwrap_err();
+    // Both would fail to spawn (neither binary exists), but the error
+    // message names the program from `dir_a`, proving precedence.
+    let zbus::fdo::Error::SpawnExecFailed(msg) = err else {
+        panic!("expected SpawnExecFailed, got {err:?}");
+    };
+    assert!(msg.contains("true-from-a"), "message was: {msg}");
+
+    fs::remove_dir_all(&dir_a).unwrap();
+    fs::remove_dir_all(&dir_b).unwrap();
+}
+
+/// End-to-end over a real `Bus` + `DBusProxy`, exercising the actual wire
+/// methods (`ListActivatableNames`, `StartServiceByName`,
+/// `UpdateActivationEnvironment`) rather than calling `Peers` directly, to
+/// prove `src/fdo/dbus.rs`'s handlers are wired up correctly end to end --
+/// same harness shape as `tests/greet.rs`/`tests/fdo.rs`.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[timeout(15000)]
+async fn activation_end_to_end_over_dbus() {
+    init_tracing();
+
+    let dir = temp_servicedir();
+    fs::write(
+        dir.join("org.example.BadExec.service"),
+        "[D-BUS Service]\nName=org.example.BadExec\n\
+         Exec=/no/such/binary/exists-really-does-not\n",
+    )
+    .unwrap();
+    fs::write(
+        dir.join("org.example.AlreadyRunning.service"),
+        "[D-BUS Service]\nName=org.example.AlreadyRunning\nExec=/usr/bin/true\n",
+    )
+    .unwrap();
+
+    let s = Alphanumeric.sample_string(&mut rng(), 10);
+    let path = temp_dir().join(s);
+    let address = format!("unix:path={}", path.display());
+
+    let mut bus = Bus::for_address(Some(&address)).await.unwrap();
+    bus.load_servicedirs(&[dir.clone()]).await;
+    let (tx, mut rx) = channel(1);
+
+    let handle = tokio::spawn(async move {
+        select! {
+            _ = rx.recv() => (),
+            res = bus.run() => match res {
+                Ok(()) => panic!("Bus exited unexpectedly"),
+                Err(e) => panic!("Bus exited with an error: {e}"),
+            }
+        }
+        bus
+    });
+
+    let ret = activation_client(&address).await;
+    let _ = tx.send(()).await;
+    let bus = handle.await.unwrap();
+    bus.cleanup().await.unwrap();
+    fs::remove_dir_all(&dir).unwrap();
+    ret.unwrap();
+}
+
+async fn activation_client(address: &str) -> anyhow::Result<()> {
+    use anyhow::ensure;
+
+    let conn = connection::Builder::address(address)?.build().await?;
+    let dbus_proxy = DBusProxy::builder(&conn)
+        .cache_properties(CacheProperties::No)
+        .build()
+        .await?;
+
+    // ListActivatableNames includes both of our scanned service files.
+    let activatable = dbus_proxy.list_activatable_names().await?;
+    ensure!(
+        activatable
+            .iter()
+            .any(|n| n.as_str() == "org.example.BadExec"),
+        "expected org.example.BadExec to be activatable"
+    );
+    ensure!(
+        activatable
+            .iter()
+            .any(|n| n.as_str() == "org.example.AlreadyRunning"),
+        "expected org.example.AlreadyRunning to be activatable"
+    );
+
+    // A name with no `.service` file at all: ServiceUnknown, promptly.
+    let name: WellKnownName = "org.example.NotAService".try_into()?;
+    let res = dbus_proxy.start_service_by_name(name, 0).await;
+    ensure!(
+        matches!(res, Err(fdo::Error::ServiceUnknown(_))),
+        "expected ServiceUnknown for a name with no .service file, got {res:?}"
+    );
+
+    // A name with a `.service` file whose Exec= doesn't exist: the spawn
+    // error surfaces over the wire, not a generic `Failed`.
+    let name: WellKnownName = "org.example.BadExec".try_into()?;
+    let res = dbus_proxy.start_service_by_name(name, 0).await;
+    ensure!(
+        matches!(res, Err(fdo::Error::SpawnExecFailed(_))),
+        "expected SpawnExecFailed for a bad Exec=, got {res:?}"
+    );
+
+    // A name we already own ourselves: StartServiceByName must report
+    // AlreadyRunning (2), not attempt to spawn anything.
+    let name: WellKnownName = "org.example.AlreadyRunning".try_into()?;
+    let reply = dbus_proxy
+        .request_name(name.clone(), RequestNameFlags::empty().into())
+        .await?;
+    ensure!(
+        reply == fdo::RequestNameReply::PrimaryOwner,
+        "expected to become primary owner"
+    );
+    let res = dbus_proxy.start_service_by_name(name, 0).await?;
+    ensure!(
+        res == 2,
+        "expected StartServiceReply::AlreadyRunning (2), got {res}"
+    );
+
+    // UpdateActivationEnvironment is implemented, not `Failed`.
+    let mut env = std::collections::HashMap::new();
+    env.insert("SOME_VAR", "some-value");
+    dbus_proxy.update_activation_environment(env).await?;
+
+    Ok(())
+}
+
+/// Regression guard for the implicit-activation hook in `Peers::send_msg`
+/// (see its doc comment on `activate_if_activatable`): a plain method call
+/// addressed to an unowned *activatable* name -- not an explicit
+/// `StartServiceByName` -- must trigger activation per the D-Bus spec, and
+/// the caller must still get a reply and not hang, even when the spawned
+/// service never claims its name. This is the same failure shape
+/// `service-unknown-reply.patch` fixed for the non-activatable case
+/// (libcosmic blocking forever on an unowned name), now checked for the
+/// "activatable but times out" case that this change newly introduces.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[timeout(15000)]
+async fn implicit_activation_spawns_and_eventually_replies_on_timeout() {
+    init_tracing();
+
+    let dir = temp_servicedir();
+    let marker = dir.join("spawned.marker");
+    fs::write(
+        dir.join("org.example.ImplicitNeverClaims.service"),
+        format!(
+            "[D-BUS Service]\nName=org.example.ImplicitNeverClaims\nExec=/usr/bin/touch {}\n",
+            marker.display()
+        ),
+    )
+    .unwrap();
+
+    let s = Alphanumeric.sample_string(&mut rng(), 10);
+    let path = temp_dir().join(s);
+    let address = format!("unix:path={}", path.display());
+
+    let mut bus = Bus::for_address(Some(&address)).await.unwrap();
+    bus.load_servicedirs(&[dir.clone()]).await;
+    let (tx, mut rx) = channel(1);
+
+    let handle = tokio::spawn(async move {
+        select! {
+            _ = rx.recv() => (),
+            res = bus.run() => match res {
+                Ok(()) => panic!("Bus exited unexpectedly"),
+                Err(e) => panic!("Bus exited with an error: {e}"),
+            }
+        }
+        bus
+    });
+
+    let conn = connection::Builder::address(address.as_str())
+        .unwrap()
+        .build()
+        .await
+        .unwrap();
+    let result = conn
+        .call_method(
+            Some("org.example.ImplicitNeverClaims"),
+            "/org/example/Test",
+            Some("org.example.Test"),
+            "Ping",
+            &(),
+        )
+        .await;
+    assert!(
+        result.is_err(),
+        "expected an error reply, not a hang or a success"
+    );
+    assert!(
+        marker.exists(),
+        "expected the Exec= program to have actually run (implicit activation spawned it)"
+    );
+
+    let _ = tx.send(()).await;
+    let bus = handle.await.unwrap();
+    bus.cleanup().await.unwrap();
+    fs::remove_dir_all(&dir).unwrap();
+}
