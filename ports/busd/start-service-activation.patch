+    /// Scan `servicedirs` for `.service` files and record the activatable
+    /// names they provide.
+    ///
+    /// This is done **once**, here, at startup (called from
+    /// `src/bin/busd.rs` right after the bus starts listening) rather than
+    /// re-scanned lazily on every lookup miss the way the reference
+    /// `dbus-daemon` does (it journals servicedir mtimes and invalidates a
+    /// cache). Startup-once is enough for us: LeandrOS images are built
+    /// read-only per boot, `.service` files don't appear or change after
+    /// boot, and it means `list_activatable_names`/activation lookups are
+    /// a plain in-memory `HashMap` read with no filesystem cost on the hot
+    /// path (which matters for the implicit-activation check in
+    /// `send_msg` below -- see its doc comment).
+    ///
+    /// A name provided by more than one file keeps its first definition
+    /// (in servicedir order, which `config::Config` already built with the
+    /// spec's precedence -- explicit `<servicedir>` entries before
+    /// `<standard_..._servicedirs>` expansions); later duplicates are
+    /// logged and dropped, matching the reference implementation's
+    /// "first one wins" rule.
+    pub async fn load_servicedirs(&self, servicedirs: &[PathBuf]) {
+        let mut map = self.activatable_services.write().await;
+        for dir in servicedirs {
+            for (path, service) in ServiceFile::scan_dir(dir) {
+                let name = match OwnedWellKnownName::try_from(service.name.clone()) {
+                    Ok(name) => name,
+                    Err(e) => {
+                        warn!(
+                            "Service file `{}` has an invalid Name `{}`: {}",
+                            path.display(),
+                            service.name,
+                            e
+                        );
+                        continue;
+                    }
+                };
+                if map.contains_key(&name) {
+                    debug!(
+                        "Ignoring duplicate activatable name `{}` from `{}`",
+                        name,
+                        path.display()
+                    );
+                    continue;
+                }
+                map.insert(name, service);
+            }
+        }
+    }
+
+    /// All names that can currently be activated (i.e. have a `.service`
+    /// file), for `org.freedesktop.DBus.ListActivatableNames`.
+    pub async fn activatable_names(&self) -> Vec<OwnedWellKnownName> {
+        self.activatable_services.read().await.keys().cloned().collect()
+    }
+
+    /// Merge `env` into the environment applied to services spawned by
+    /// future activations, for `UpdateActivationEnvironment`.
+    pub async fn update_activation_environment(&self, env: HashMap<String, String>) {
+        self.activation_environment.write().await.extend(env);
+    }
+
+    /// Look up `name` in the scanned service map without attempting
+    /// activation. Used by `send_msg`'s implicit-activation hook to decide,
+    /// with no spawn/wait cost, whether an unowned name is even a
+    /// candidate for activation.
+    async fn is_activatable(&self, name: &WellKnownName<'_>) -> bool {
+        self.activatable_services.read().await.contains_key(name.as_str())
+    }
+
+    /// Try to activate `name`: look it up in the scanned service map, spawn
+    /// its `Exec=` command line, and wait (bounded by `ACTIVATION_TIMEOUT`)
+    /// for it to actually call `RequestName` and appear in the name
+    /// registry. A process that spawned but hasn't yet claimed the name it
+    /// promised is not "started" in the D-Bus sense.
+    ///
+    /// Returns the exact D-Bus error to report on failure:
+    ///   * `ServiceUnknown` -- no `.service` file provides this name.
+    ///   * `SpawnExecFailed` -- `Command::spawn` itself failed (bad `Exec=`,
+    ///     ENOENT, EPERM, ...), or the `Exec=` line was empty.
+    ///   * `SpawnChildExited` -- the process spawned but never claimed the
+    ///     name within the timeout. We don't distinguish "exited quickly"
+    ///     from "still running but slow/broken" since `std::process::Child`
+    ///     isn't polled here (we intentionally don't `wait()` on it, so the
+    ///     child can outlive this call the way a real service does); this
+    ///     is the closest standard error code for "activation didn't pan
+    ///     out in time".
+    pub async fn activate_service(
+        &self,
+        name: &WellKnownName<'_>,
+    ) -> std::result::Result<(), zbus::fdo::Error> {
+        let service = self.activatable_services.read().await.get(name.as_str()).cloned();
+        let Some(service) = service else {
+            return Err(zbus::fdo::Error::ServiceUnknown(format!(
+                "The name {name} was not provided by any .service files"
+            )));
+        };
+
+        if let Some(user) = &service.user {
+            // busd has no setuid-helper/privilege-drop implementation (see
+            // `ports/dbus/session-pkg/session.conf`), and LeandrOS's
+            // session bring-up is single-user/root-only, so we can't
+            // actually honour a `User=` that isn't the user we're already
+            // running as. We still spawn -- refusing to activate a service
+            // just because it politely declared a `User=` we can't switch
+            // to would be worse than running it as ourselves.
+            debug!(
+                "Service for `{name}` requests User={user}, but busd cannot change users; \
+                 spawning as the daemon's own user"
+            );
+        }
+
+        let mut parts = service.exec.split_whitespace();
+        let Some(program) = parts.next() else {
+            return Err(zbus::fdo::Error::SpawnExecFailed(format!(
+                "Service file for `{name}` has an empty Exec="
+            )));
+        };
+
+        let mut command = std::process::Command::new(program);
+        command.args(parts);
+        for (key, value) in self.activation_environment.read().await.iter() {
+            command.env(key, value);
+        }
+
+        if let Err(e) = command.spawn() {
+            return Err(zbus::fdo::Error::SpawnExecFailed(format!(
+                "Failed to execute `{program}` for name `{name}`: {e}"
+            )));
+        }
+
+        self.await_name_owner(name, ACTIVATION_TIMEOUT).await
+    }
+
+    /// Poll the name registry until `name` has an owner or `timeout`
+    /// elapses. Each iteration acquires and releases the `name_registry`
+    /// read lock rather than holding it across the `sleep`, so a writer
+    /// (e.g. the very `RequestName` call we're waiting for) is never
+    /// starved by this loop -- same discipline as `send_msg` below.
+    async fn await_name_owner(
+        &self,
+        name: &WellKnownName<'_>,
+        timeout: Duration,
+    ) -> std::result::Result<(), zbus::fdo::Error> {
+        let deadline = tokio::time::Instant::now() + timeout;
+        loop {
+            if self.name_registry.read().await.lookup(name.clone()).is_some() {
+                return Ok(());
+            }
+            if tokio::time::Instant::now() >= deadline {
+                return Err(zbus::fdo::Error::SpawnChildExited(format!(
+                    "Activated service for `{name}` did not claim the name within {timeout:?}"
+                )));
+            }
+            tokio::time::sleep(ACTIVATION_POLL_INTERVAL).await;
+        }
+    }
+
+    /// Implicit activation for `send_msg`'s routing path: if `name` is
+    /// unowned but a `.service` file provides it, activate it (spawn +
+    /// wait, exactly as an explicit `StartServiceByName` call would) and
+    /// return its now-registered owner.
+    ///
+    /// Returns `None` immediately, with **no spawn attempt and no delay**,
+    /// if `name` isn't in the scanned service map. This is the crucial
+    /// property: it keeps the non-activatable path -- the overwhelming
+    /// majority of unowned-name calls in a real session, per
+    /// `service-unknown-reply.patch`'s measurements (single-instance
+    /// probes to app IDs nobody ships a `.service` file for) -- exactly as
+    /// fast as it was before activation existed, so `send_msg` still falls
+    /// through to `reply_service_unknown` promptly instead of ever
+    /// re-introducing the hang that patch fixed.
+    async fn activate_if_activatable(&self, name: &WellKnownName<'_>) -> Option<OwnedUniqueName> {
+        if !self.is_activatable(name).await {
+            return None;
+        }
+        if let Err(e) = self.activate_service(name).await {
+            warn!("Implicit activation of `{name}` failed: {e}");
+            return None;
+        }
+        self.name_registry.read().await.lookup(name.clone())
+    }
