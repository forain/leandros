+//! Parsing of D-Bus `.service` activation files.
+//!
+//! These are simple INI-style key files with a single `[D-BUS Service]`
+//! section, documented at
+//! <https://dbus.freedesktop.org/doc/dbus-daemon.1.html#service-files>. We
+//! only need `Name=` (the well-known bus name this file activates) and
+//! `Exec=` (the command line to run). `User=` is recorded, though busd has
+//! no privilege-dropping story yet -- see `Peers::activate_service`.
+//! `SystemdService=` is recognized and ignored: we have no systemd.
+
+use std::{
+    ffi::OsStr,
+    fs,
+    path::{Path, PathBuf},
+};
+
+use tracing::warn;
+
+/// A parsed `.service` file, as far as busd cares.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ServiceFile {
+    /// The well-known bus name this file activates (`Name=`).
+    pub name: String,
+    /// The command line to run to provide that name (`Exec=`).
+    pub exec: String,
+    /// The user the service should ideally run as (`User=`), if given.
+    ///
+    /// busd has no setuid-helper/privilege-drop implementation (see
+    /// `ports/dbus/session-pkg/session.conf`'s header comment), so this is
+    /// currently only used to `warn!` when it doesn't match reality rather
+    /// than to actually change the spawned process's credentials.
+    pub user: Option<String>,
+}
+
+impl ServiceFile {
+    /// Parse the contents of a single `.service` file.
+    ///
+    /// Returns `None` for anything malformed: no `[D-BUS Service]` section,
+    /// or a section missing `Name`/`Exec`. This never returns an `Err`
+    /// because callers must treat a broken/foreign `.service` file as
+    /// "skip it", never as a reason to fail bus startup.
+    pub fn parse(input: &str) -> Option<Self> {
+        let mut in_section = false;
+        let mut name = None;
+        let mut exec = None;
+        let mut user = None;
+
+        for line in input.lines() {
+            let line = line.trim();
+            if line.is_empty() || line.starts_with('#') || line.starts_with(';') {
+                continue;
+            }
+            if line.starts_with('[') {
+                // A (malformed) line like `[Foo` with no closing bracket is
+                // treated as "not our section" rather than panicking on the
+                // missing `strip_suffix`.
+                in_section = line.strip_suffix(']') == Some("[D-BUS Service]")
+                    || line == "[D-BUS Service]";
+                continue;
+            }
+            if !in_section {
+                continue;
+            }
+            let Some((key, value)) = line.split_once('=') else {
+                // Not a `Key=Value` line; ignore rather than fail the whole
+                // file, in case of stray comments/continuation lines from a
+                // future spec revision.
+                continue;
+            };
+            match key.trim() {
+                "Name" => name = Some(value.trim().to_string()),
+                "Exec" => exec = Some(value.trim().to_string()),
+                "User" => user = Some(value.trim().to_string()),
+                // `SystemdService=` and any other/vendor key: ignored
+                // gracefully, per the spec's forward-compatibility rules.
+                _ => {}
+            }
+        }
+
+        Some(ServiceFile {
+            name: name?,
+            exec: exec?,
+            user,
+        })
+    }
+
+    /// Scan a single directory (non-recursively) for `*.service` files,
+    /// parsing each one.
+    ///
+    /// Errors are never propagated: an unreadable directory, an unreadable
+    /// file, or a malformed file are all logged with `warn!` and skipped.
+    /// One bad servicedir or `.service` file must never prevent the bus
+    /// from starting.
+    pub fn scan_dir(dir: &Path) -> Vec<(PathBuf, ServiceFile)> {
+        let mut out = Vec::new();
+
+        let entries = match fs::read_dir(dir) {
+            Ok(entries) => entries,
+            Err(e) => {
+                // Most configured servicedirs won't exist on any given
+                // image; that's the common case, not a warning.
+                if e.kind() != std::io::ErrorKind::NotFound {
+                    warn!("Couldn't read service directory `{}`: {}", dir.display(), e);
+                }
+                return out;
+            }
+        };
+
+        for entry in entries {
+            let entry = match entry {
+                Ok(entry) => entry,
+                Err(e) => {
+                    warn!("Couldn't read an entry in `{}`: {}", dir.display(), e);
+                    continue;
+                }
+            };
+            let path = entry.path();
+            if path.extension() != Some(OsStr::new("service")) {
+                continue;
+            }
+            let contents = match fs::read_to_string(&path) {
+                Ok(contents) => contents,
+                Err(e) => {
+                    warn!("Couldn't read service file `{}`: {}", path.display(), e);
+                    continue;
+                }
+            };
+            match Self::parse(&contents) {
+                Some(service) => out.push((path, service)),
+                None => warn!(
+                    "Skipping malformed service file `{}` (no [D-BUS Service] section, or \
+                     missing Name/Exec)",
+                    path.display()
+                ),
+            }
+        }
+
+        out
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parse_minimal_ok() {
+        let input = "[D-BUS Service]\nName=org.example.Foo\nExec=/usr/bin/foo --flag\n";
+        assert_eq!(
+            ServiceFile::parse(input),
+            Some(ServiceFile {
+                name: "org.example.Foo".to_string(),
+                exec: "/usr/bin/foo --flag".to_string(),
+                user: None,
+            })
+        );
+    }
+
+    #[test]
+    fn parse_with_user_and_systemdservice_ok() {
+        let input = "[D-BUS Service]\nName=org.example.Foo\nExec=/usr/bin/foo\nUser=alice\n\
+                      SystemdService=org.example.Foo.service\n";
+        assert_eq!(
+            ServiceFile::parse(input),
+            Some(ServiceFile {
+                name: "org.example.Foo".to_string(),
+                exec: "/usr/bin/foo".to_string(),
+                user: Some("alice".to_string()),
+            })
+        );
+    }
+
+    #[test]
+    fn parse_ignores_comments_and_blank_lines() {
+        let input = "; a comment\n#another\n\n[D-BUS Service]\n\nName=org.example.Foo\n\
+                      Exec=/usr/bin/foo\n";
+        assert_eq!(
+            ServiceFile::parse(input),
+            Some(ServiceFile {
+                name: "org.example.Foo".to_string(),
+                exec: "/usr/bin/foo".to_string(),
+                user: None,
+            })
+        );
+    }
+
+    #[test]
+    fn parse_ignores_other_sections() {
+        let input = "[Other Section]\nName=wrong\nExec=wrong\n[D-BUS Service]\n\
+                      Name=org.example.Foo\nExec=/usr/bin/foo\n";
+        assert_eq!(
+            ServiceFile::parse(input),
+            Some(ServiceFile {
+                name: "org.example.Foo".to_string(),
+                exec: "/usr/bin/foo".to_string(),
+                user: None,
+            })
+        );
+    }
+
+    #[test]
+    fn parse_missing_name_is_none() {
+        let input = "[D-BUS Service]\nExec=/usr/bin/foo\n";
+        assert_eq!(ServiceFile::parse(input), None);
+    }
+
+    #[test]
+    fn parse_missing_exec_is_none() {
+        let input = "[D-BUS Service]\nName=org.example.Foo\n";
+        assert_eq!(ServiceFile::parse(input), None);
+    }
+
+    #[test]
+    fn parse_missing_section_is_none() {
+        let input = "Name=org.example.Foo\nExec=/usr/bin/foo\n";
+        assert_eq!(ServiceFile::parse(input), None);
+    }
+
+    #[test]
+    fn parse_empty_input_is_none() {
+        assert_eq!(ServiceFile::parse(""), None);
+    }
+
+    #[test]
+    fn scan_dir_skips_non_service_files_and_missing_dir() {
+        let dir = std::env::temp_dir().join(format!(
+            "busd-service-file-test-{}-{}",
+            std::process::id(),
+            fastrand::u64(..)
+        ));
+        std::fs::create_dir_all(&dir).unwrap();
+
+        std::fs::write(
+            dir.join("good.service"),
+            "[D-BUS Service]\nName=org.example.Good\nExec=/usr/bin/good\n",
+        )
+        .unwrap();
+        std::fs::write(dir.join("not-a-service.txt"), "irrelevant").unwrap();
+        std::fs::write(dir.join("bad.service"), "no section here").unwrap();
+
+        let mut found = ServiceFile::scan_dir(&dir);
+        found.sort_by(|a, b| a.1.name.cmp(&b.1.name));
+        assert_eq!(found.len(), 1);
+        assert_eq!(found[0].1.name, "org.example.Good");
+
+        // A missing directory must not panic or return anything.
+        assert!(ServiceFile::scan_dir(&dir.join("does-not-exist")).is_empty());
+
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+}
