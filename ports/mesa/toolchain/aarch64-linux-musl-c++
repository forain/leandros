#!/bin/sh
# zig c++ musl cross wrapper (aarch64-linux-musl). Space-safe in-place argv rewrite that also
# normalizes  -Wl,--version-script <path>  ->  -Wl,--version-script=<path>
# (zig/lld rejects the bare positional script path, and the unquoted-string
# rebuild used previously tore apart args containing spaces such as
# -DXMLIMPORT=__attribute__ ((visibility("default"))) from expat).
n=$#
while [ $n -gt 0 ]; do
  a=$1; shift; n=$((n-1))
  case $a in
    -Wl,--version-script|-Wl,--dynamic-list)
      b=$1; shift; n=$((n-1))
      set -- "$@" "$a=$b"
      ;;
    *)
      set -- "$@" "$a"
      ;;
  esac
done
exec zig c++ -target aarch64-linux-musl "$@"
