+    Ok(())
+}
+
+/// Sends a signal to every process in a process group.
+///
+/// # Arguments
+/// * `pgid` - The process group ID to send the signal to
+/// * `signal` - The signal to send (must be a real signal, not a trap signal)
+pub fn kill_process_group(
+    pgid: sys::process::ProcessId,
+    signal: traps::TrapSignal,
+) -> Result<(), error::Error> {
+    nix::sys::signal::killpg(nix::unistd::Pid::from_raw(pgid), translate_signal(signal)?)
+        .map_err(|_errno| error::ErrorKind::FailedToSendSignal)?;
+    Ok(())
+}
+
+/// Maps a trap signal onto the signal `kill(2)` sends for it. `TrapSignal::Exit` stands in for
+/// POSIX signal 0: sending it delivers nothing but still performs the usual error checking, so
+/// it probes whether a process exists (and whether we may signal it), which is what `kill -0`
+/// relies on. Passing `None` to `nix::sys::signal::kill` sends signal 0.
+fn translate_signal(signal: traps::TrapSignal) -> Result<Option<Signal>, error::Error> {
+    match signal {
+        traps::TrapSignal::Signal(signal) => Ok(Some(signal)),
+        traps::TrapSignal::Exit => Ok(None),
+        traps::TrapSignal::Debug | traps::TrapSignal::Err | traps::TrapSignal::Return => {
+            Err(error::ErrorKind::InvalidSignal(signal.to_string()).into())
+        }
+    }
+}
