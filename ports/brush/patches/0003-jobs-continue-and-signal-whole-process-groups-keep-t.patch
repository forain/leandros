+#[test_with::executable(sleep)]
+#[test]
+fn run_pipeline_suspend_and_fg() -> anyhow::Result<()> {
+    let mut session = start_shell_session()?;
+
+    // Start a pipeline; every member is a process, so ^Z stops all of them.
+    session.expect_prompt()?;
+    session.send_line("sleep 2 | cat")?;
+
+    // Suspend it, then bring it back: `fg` must continue the WHOLE process group (not just
+    // the leader), so the pipeline has to run to completion and get reported as done rather
+    // than as stopped again — and the shell must be usable afterwards.
+    std::thread::sleep(std::time::Duration::from_millis(500));
+    session.suspend()?;
+    session.expect("Stopped")?;
+    session.expect_prompt()?;
+
+    let jobs_output = session.exec_output("jobs")?;
+    assert!(jobs_output.contains("Stopped"));
+
+    session.send_line("fg")?;
+    session.expect("sleep 2")?;
+    session.expect_prompt()?;
+
+    let jobs_output = session.exec_output("jobs")?;
+    assert!(
+        !jobs_output.contains("Stopped"),
+        "pipeline still stopped after fg: {jobs_output}"
+    );
+
+    let output = session.exec_output("echo alive")?;
+    assert!(output.contains("alive"));
+
+    session.exit()?;
+
+    Ok(())
+}
+
+#[test_with::executable(sleep)]
+#[test]
+fn run_in_background_reports_pid() -> anyhow::Result<()> {
+    let mut session = start_shell_session()?;
+
+    // `cmd &` must announce the job with a real PID, like bash, and $! must be that PID
+    // from the very next command on.
+    session.expect_prompt()?;
+    session.send_line("sleep 1 &")?;
+    let announcement = session.expect(expectrl::Regex(r"\[1\]\+?\s+(\d+)"))?;
+    let announced_pid = String::from_utf8(announcement.get(1).unwrap().to_vec())?;
+    session.expect_prompt()?;
+
+    let pid_output = session.exec_output("echo $!")?;
+    assert!(
+        pid_output.contains(&announced_pid),
+        "$! ({pid_output}) does not match the announced PID ({announced_pid})"
+    );
+
+    let jobs_output = session.exec_output("jobs -p")?;
+    assert!(jobs_output.contains(&announced_pid));
+
+    session.send_line("wait")?;
+    session.expect_prompt()?;
+
+    session.exit()?;
+
+    Ok(())
+}
