+
+/// Hands the terminal to the job, continues it, announces it, and waits for it to complete
+/// or stop. The shell takes the terminal back on every path — a failed hand-over or a failed
+/// wait included — since a terminal left with a job's process group makes the shell's next
+/// read a background read (SIGTTIN, or EIO for an orphaned login shell), which wedges it.
+async fn run_in_foreground(
+    job: &mut jobs::Job,
+    is_interactive: bool,
+    stderr: &mut impl Write,
+) -> Result<ExecutionResult, brush_core::Error> {
+    let result = match job.move_to_foreground() {
+        Ok(()) => {
+            // Announce only once the job owns the terminal and is running, so that a ^Z
+            // typed right after the announcement reaches the job rather than the shell.
+            writeln!(stderr, "{}", job.command_line)?;
+            job.wait().await
+        }
+        Err(e) => Err(e),
+    };
+
+    if is_interactive {
+        let _ = sys::terminal::move_self_to_foreground();
+    }
+
+    result
+}
