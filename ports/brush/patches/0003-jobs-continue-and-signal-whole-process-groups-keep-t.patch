+
+        for task in &self.tasks {
+            if let JobTask::External(p) = task {
+                if let Some(pgid) = p.pgid() {
+                    return Some(pgid);
+                }
+            }
+        }
+
+        self.pid_slot
+            .as_ref()
+            .and_then(|slot| slot.get())
+            .and_then(|(_pid, pgid)| pgid)
     }
 }
