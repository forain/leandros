+/// A shared slot through which an asynchronously-executing (background) job publishes the
+/// identity of its first command. Background jobs run inside a Tokio task
+/// (`JobTask::Internal`), so nothing is known about their processes at the time the job is
+/// registered; the task resolves this slot as soon as it has decided what its first command
+/// is — the PID (and process group) of the first external process it spawns, or "no
+/// process" when that command is a builtin, a function or a compound command — which lets
+/// the parent shell report a representative PID for `[n] pid`, `$!`, `jobs` and `kill %n`,
+/// and lets `fg`/`bg`/`kill %n` reach the job's process group.
+pub(crate) struct AsyncPidSlot {
+    state: Mutex<AsyncPidState>,
+    resolved: tokio::sync::Notify,
+}
+
+#[derive(Clone, Copy)]
+enum AsyncPidState {
+    Pending,
+    Resolved {
+        pid: Option<sys::process::ProcessId>,
+        pgid: Option<sys::process::ProcessId>,
+    },
+}
+
+impl AsyncPidSlot {
+    /// Returns a new, unresolved slot.
+    pub(crate) fn new() -> Arc<Self> {
+        Arc::new(Self {
+            state: Mutex::new(AsyncPidState::Pending),
+            resolved: tokio::sync::Notify::new(),
+        })
+    }
+
+    /// Resolves the slot; the first resolution wins and later ones are ignored.
+    ///
+    /// # Arguments
+    ///
+    /// * `pid` - The PID of the job's first external process, if it has one.
+    /// * `pgid` - That process's process group, if known.
+    pub(crate) fn resolve(
+        &self,
+        pid: Option<sys::process::ProcessId>,
+        pgid: Option<sys::process::ProcessId>,
+    ) {
+        {
+            let mut state = self
+                .state
+                .lock()
+                .unwrap_or_else(|poisoned| poisoned.into_inner());
+            if matches!(*state, AsyncPidState::Resolved { .. }) {
+                return;
+            }
+            *state = AsyncPidState::Resolved { pid, pgid };
+        }
+        self.resolved.notify_waiters();
+    }
+
+    /// Returns `(pid, pgid)` once resolved, `None` while still pending.
+    pub(crate) fn get(
+        &self,
+    ) -> Option<(
+        Option<sys::process::ProcessId>,
+        Option<sys::process::ProcessId>,
+    )> {
+        let state = *self
+            .state
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        match state {
+            AsyncPidState::Pending => None,
+            AsyncPidState::Resolved { pid, pgid } => Some((pid, pgid)),
+        }
+    }
+
+    /// Waits until the slot has been resolved.
+    pub(crate) async fn wait_resolved(&self) {
+        loop {
+            let notified = self.resolved.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            if self.get().is_some() {
+                return;
+            }
+            notified.await;
+        }
+    }
+}
 
