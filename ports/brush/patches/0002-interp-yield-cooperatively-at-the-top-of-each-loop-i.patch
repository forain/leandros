From f02a328ffc0705bb16c0152c27b6d4f29c7b64c5 Mon Sep 17 00:00:00 2001
From: Leandro Forain <leandro.forain@instructure.com>
Date: Fri, 18 Sep 2026 00:56:04 -0300
Subject: [PATCH 2/3] interp: yield cooperatively at the top of each loop
 iteration

A background subshell runs as an in-process task, and a builtin-only loop
body such as `while :; do :; done` never reaches a pending await, so N of
them running in the background occupy all N runtime workers and the shell
stops responding. Yield once per iteration in the while/until, for and
arithmetic-for loops via consume_budget, which costs nothing on an
ordinary loop and lets the worker pick up other tasks on a busy one.
---
 brush-core/src/interp.rs | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/brush-core/src/interp.rs b/brush-core/src/interp.rs
index 134fc95..e839662 100644
--- a/brush-core/src/interp.rs
+++ b/brush-core/src/interp.rs
@@ -849,6 +849,8 @@ impl Execute for ast::ForClauseCommand {
         }
 
         for value in expanded_values {
+            tokio::task::consume_budget().await;
+
             if shell.options().print_commands_and_arguments {
                 if let Some(unexpanded_values) = &self.values {
                     shell
@@ -1037,6 +1039,12 @@ impl Execute for (WhileOrUntil, &ast::WhileOrUntilClauseCommand) {
         condition_params.suppress_errexit = true;
 
         loop {
+            // Cooperatively yield at the top of every iteration: a builtin-only loop body
+            // (e.g. `while :; do :; done`) never reaches a pending await on its own, so
+            // without this a background `( ... ) &` running one of these can starve the
+            // whole tokio worker pool.
+            tokio::task::consume_budget().await;
+
             let condition_result = test_condition.execute(shell, &condition_params).await?;
 
             // Update status for condition
@@ -1107,6 +1115,8 @@ impl Execute for ast::ArithmeticForClauseCommand {
         }
 
         loop {
+            tokio::task::consume_budget().await;
+
             if let Some(condition) = &self.condition {
                 // An empty condition (e.g., `for (( ; ; ))`) means "always true".
                 if !condition.value.is_empty() && condition.eval(shell, params, true).await? == 0 {
