+
+# LeandrOS: local fork of crossterm 0.29.0 fixing the unix CPR
+# (cursor-position-report) request/response desync in
+# src/cursor/sys/unix.rs::read_position_raw — a stale/orphaned ESC[6n reply
+# (from a timeout or a signal-interrupted poll) used to get handed to the
+# NEXT caller of cursor::position(), which is what made reedline paint
+# command output over itself on aarch64 (TODO item 17). See
+# /Users/forain/code/crossterm's git history for the patch. Covers reedline's
+# transitive crossterm dependency too, since this is a workspace-wide patch.
+[patch.crates-io]
+crossterm = { path = "../crossterm" }
