 brush-core/src/interp.rs          | 28 +++++++++++++++++++++++++--
 brush-core/src/jobs.rs            | 32 +++++++++++++++++++++++++++++++
 brush-core/src/sys/unix/signal.rs | 14 ++++++++------
 6 files changed, 83 insertions(+), 14 deletions(-)

