diff --git a/brush-core/src/sys/unix/signal.rs b/brush-core/src/sys/unix/signal.rs
index 36830d6..1e9cb2b 100644
--- a/brush-core/src/sys/unix/signal.rs
+++ b/brush-core/src/sys/unix/signal.rs
@@ -19,12 +19,14 @@ pub fn kill_process(
     pid: sys::process::ProcessId,
     signal: traps::TrapSignal,
 ) -> Result<(), error::Error> {
-    let translated_signal = match signal {
-        traps::TrapSignal::Signal(signal) => signal,
-        traps::TrapSignal::Debug
-        | traps::TrapSignal::Err
-        | traps::TrapSignal::Exit
-        | traps::TrapSignal::Return => {
+    // A `TrapSignal::Exit` here stands in for POSIX signal 0. Sending signal 0 does not deliver
+    // a signal but still performs the usual error checking, so it can be used to probe whether a
+    // process exists (and whether we have permission to signal it). This is what `kill -0` relies
+    // on. Passing `None` to `nix::sys::signal::kill` sends signal 0.
+    let translated_signal: Option<Signal> = match signal {
+        traps::TrapSignal::Signal(signal) => Some(signal),
+        traps::TrapSignal::Exit => None,
+        traps::TrapSignal::Debug | traps::TrapSignal::Err | traps::TrapSignal::Return => {
             return Err(error::ErrorKind::InvalidSignal(signal.to_string()).into());
         }
     };
