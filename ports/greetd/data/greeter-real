# greeter-real — bring the greeter up behind the real greetd daemon.
#
# Run as:  sh /bin/greeter-real        (the kernel has no shebang binfmt)
#
# Step 2 of the port: everything fakegreet skips is now in frame — PAM through
# ports/greetd/pam-leandros, the session worker re-exec of /proc/self/exe, the
# socketpair between daemon and worker, tokio's four signal streams, mlockall,
# and the privilege handling. The VT layer is configured away with vt = "none"
# in /etc/greetd/greetd.conf (TerminalMode::Stdin), which is the only value that
# keeps greetd off /dev/tty0 entirely.
#
# greetd builds a session's environment ENTIRELY from its PAM env table and
# inherits nothing of its own, so the render environment reaches the greeter
# through /etc/profile and `source_profile = true`, not through this script.
# What this script exports is what *greetd itself* runs with.
set -u

. /bin/greeter-env

# No hardware GL renderer: do not start greetd at all. Exit status 78
# (EX_CONFIG) tells init this is a configuration refusal, not a crash — it
# prints the reason on the serial console once and stops respawning, so a
# headless test boot gets its serial login without a fork storm.
if [ "$LEANDROS_RENDERER_PATH" = refused ]; then
    echo "GREETER-REAL: no GPU renderer (card0=${GPU_DRM_NAME:-none} venus=$GPU_VENUS virgl=$GPU_VIRGL); not starting greetd" >&2
    exit 78
fi
echo "GREETER-REAL: renderer=$LEANDROS_RENDERER_PATH GL_RENDERER='$LEANDROS_GL_RENDERER'"

# No passwd role switch — see greeter-fake. greetd's default_session.user stays
# "root" so cosmic-comp keeps its privileges; /bin/greeter-launch, the kiosk
# child named in greetd.conf, is what drops to uid 990.

# greetd binds its control socket at <dir>/greetd-<pid>.sock, and upstream
# hardcodes <dir> = /run because on Linux /run is a tmpfs. On LeandrOS /run is
# an ordinary f2fs directory and f2fs has no S_IFSOCK support, so that bind
# fails with EOPNOTSUPP ("unable to open listener: Not supported (os error 95)")
# before the greeter is ever spawned. The socket-capable mounts are /tmp,
# /dev/shm and /run/user (servers/vfs TMPFS_ROOTS). GREETD_SOCK_DIR is
# ports/greetd/patches/0003; unset, greetd behaves exactly as upstream.
#
# The directory is the GREETER ACCOUNT's runtime dir, not root's: the greeter
# client connects to this socket as uid 990, and the VFS enforces search
# permission on the path — a 0700 root /run/user/0 is EACCES for it. greetd
# chowns the socket to default_session.user (root, because the compositor is
# the session); /bin/greeter-launch re-chowns it to the greeter account before
# dropping to it. See greeter-env.
GREETD_SOCK_DIR=$GREETER_RUNTIME_DIR
export GREETD_SOCK_DIR

cd "$XDG_RUNTIME_DIR"

echo "GREETER-REAL: launching greetd"
exec /bin/greetd
