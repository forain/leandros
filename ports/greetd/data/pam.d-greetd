# /etc/pam.d/greetd -- real Linux-PAM (Alpine's linux-pam, pam_unix over
# /etc/shadow). The greeter session itself authenticates nobody, the user's
# login does. XDG_RUNTIME_DIR is NOT exported here: the greeter session runs as
# root and must keep the greeter account's runtime dir.
auth       include    base-auth
account    include    base-account
password   include    base-password
session    include    base-session-noninteractive
