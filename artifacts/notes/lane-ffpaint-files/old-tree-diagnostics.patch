+// DIAG(ffpaint): a poll/epoll wait that slept to its deadline although one of
+// its fds is ready right after = a wake that never came (masked by the
+// timeout). Only waits of >= LATEWAKE_MIN_NS are checked.
+const LATEWAKE_MIN_NS: u64 = 200_000_000;
+static LATEWAKE_N: AtomicU64 = AtomicU64::new(0);
+fn latewake_poll(pid: u32, fds_ptr: usize, nfds: usize, mask: u64, slept: u64) {
+    const POLLNVAL: u32 = 0x0020;
+    for i in 0..nfds {
+        let pfd = fds_ptr + i * 8;
+        let fd     = unsafe { core::ptr::read(pfd       as *const i32) };
+        let events = unsafe { core::ptr::read((pfd + 4) as *const i16) };
+        if fd < 0 { continue; }
+        let (rev, _seq, tag) = probe_fd_events_seq(pid, fd as usize, events as u16 as u32);
+        if rev != 0 && rev != POLLNVAL {
+            let n = LATEWAKE_N.fetch_add(1, Ordering::Relaxed);
+            if n < 2000 {
+                crate::serial_print_str("[LATEWAKE] poll pid="); crate::print_number(pid);
+                crate::serial_print_str(" tgid="); crate::print_number(sched::current_tgid() as u32);
+                crate::serial_print_str(" fd="); crate::print_number((fd) as u32);
+                crate::serial_print_str(" ev="); crate::serial_print_hex(events as u16 as usize);
+                crate::serial_print_str(" rev="); crate::serial_print_hex(rev as usize);
+                crate::serial_print_str(" tag="); crate::serial_print_hex(tag as usize);
+                crate::serial_print_str(" mask="); crate::serial_print_hex(mask as usize);
+                crate::serial_print_str(" hit="); crate::print_number((((tag & mask) != 0)) as u32);
+                crate::serial_print_str(" slept_ms="); crate::print_number(((slept / 1_000_000)) as u32);
+                crate::serial_print_str(" n="); crate::print_number((n) as u32);
+                crate::serial_print_str("\n");
+            }
+            return;
+        }
+    }
+}
+fn latewake_epoll(pid: u32, slot: usize, mask: u64, slept: u64) {
+    let hi = { EPOLL_INSTANCES.lock()[slot].hi as usize };
+    for i in 0..hi {
+        let interest = { EPOLL_INSTANCES.lock()[slot].interests[i] };
+        if !interest.in_use || !interest.armed { continue; }
+        let (cur, seq, tag) = probe_interest(pid, slot, &interest, 0);
+        if cur & POLLNVAL_EP != 0 { continue; }
+        let et = interest.events & EPOLLET != 0;
+        let fire = cur != 0 && (!et || match seq { Some(s) => s != interest.last_seq, None => true });
+        if fire {
+            let n = LATEWAKE_N.fetch_add(1, Ordering::Relaxed);
+            if n < 2000 {
+                crate::serial_print_str("[LATEWAKE] epoll pid="); crate::print_number(pid);
+                crate::serial_print_str(" tgid="); crate::print_number(sched::current_tgid() as u32);
+                crate::serial_print_str(" fd="); crate::print_number((interest.fd) as u32);
+                crate::serial_print_str(" ev="); crate::serial_print_hex(interest.events as usize);
+                crate::serial_print_str(" rev="); crate::serial_print_hex(cur as usize);
+                crate::serial_print_str(" tag="); crate::serial_print_hex(tag as usize);
+                crate::serial_print_str(" mask="); crate::serial_print_hex(mask as usize);
+                crate::serial_print_str(" hit="); crate::print_number((((tag & mask) != 0)) as u32);
+                crate::serial_print_str(" slept_ms="); crate::print_number(((slept / 1_000_000)) as u32);
+                crate::serial_print_str(" n="); crate::print_number((n) as u32);
+                crate::serial_print_str("\n");
+            }
+            return;
+        }
+    }
+}
