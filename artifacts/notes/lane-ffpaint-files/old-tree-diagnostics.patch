+// DIAG(ffpaint): thread names from PR_SET_NAME, keyed by pid (mod 4096).
+static THREAD_NAMES: [[AtomicU64; 2]; 4096] = [const { [AtomicU64::new(0), AtomicU64::new(0)] }; 4096];
+pub fn set_thread_name(pid: u32, name: &[u8; 16]) {
+    let e = &THREAD_NAMES[(pid as usize) & 4095];
+    e[0].store(u64::from_le_bytes(name[0..8].try_into().unwrap()), Ordering::Relaxed);
+    e[1].store(u64::from_le_bytes(name[8..16].try_into().unwrap()), Ordering::Relaxed);
+}
+pub fn thread_name(pid: u32) -> [u8; 16] {
+    let e = &THREAD_NAMES[(pid as usize) & 4095];
+    let mut o = [0u8; 16];
+    o[0..8].copy_from_slice(&e[0].load(Ordering::Relaxed).to_le_bytes());
+    o[8..16].copy_from_slice(&e[1].load(Ordering::Relaxed).to_le_bytes());
+    o
+}
