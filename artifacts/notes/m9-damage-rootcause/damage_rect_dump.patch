--- a/drivers/src/drm_device_interface.rs
+++ b/drivers/src/drm_device_interface.rs
@@ -1194,6 +1194,23 @@
 static DAMAGE_SKIP: AtomicU64 = AtomicU64::new(0);
 static DAMAGE_PX: AtomicU64 = AtomicU64::new(0);
 static BLOBS_CREATED: AtomicU64 = AtomicU64::new(0);
+
+/// Total number of clip rects across every rect-path present, and how many
+/// presents we have already dumped in full.
+///
+/// `dmg_px` alone cannot tell smithay's three "damage everything" fallbacks
+/// (each of which emits exactly ONE rect equal to the output) from its
+/// `DamageShaper` inflating a real, scattered damage set (which emits many).
+/// `PlaneDamageClips::from_damage` copies the shaper's output into the blob
+/// one rect for one rect, so the rect COUNT read here is the damage tracker's
+/// verbatim output — the one datum that separates the two.
+static DAMAGE_NRECTS: AtomicU64 = AtomicU64::new(0);
+static DAMAGE_DUMPED: AtomicU64 = AtomicU64::new(0);
+
+/// How many large-damage presents to print in full. Bounded on purpose: the
+/// dump is a few hundred bytes of serial per present and the compositor is
+/// already the bottleneck.
+const DAMAGE_DUMP_LIMIT: u64 = 12;
 
 /// Primary-plane state of the last commit we actually presented.
 ///
@@ -1276,6 +1293,31 @@
         total = total.saturating_add(w.saturating_mul(h));
     }
     total
+}
+
+/// Print a clip list verbatim, once, for a present that damaged a lot.
+///
+/// Format is deliberately self-checking: `n=` comes FIRST, the rects follow,
+/// and the line is terminated by a fixed sentinel. An analyser MUST assert
+/// that it parsed exactly `n` rects AND saw the sentinel, so a truncated or
+/// interleaved serial line fails loudly instead of silently under-reporting —
+/// which is precisely how three harnesses lied during the 2026-08-06 wave.
+///
+/// Called with no locks held (`damage_rects` has already released `BLOBS`).
+fn damage_dump(rects: &[(i32, i32, i32, i32)]) {
+    crate::pci::serial_debug("[DMGRECTS] n=");
+    crate::pci::serial_debug_hex_64(rects.len() as u64);
+    for &(x1, y1, x2, y2) in rects {
+        crate::pci::serial_debug(" r=");
+        crate::pci::serial_debug_hex_64(x1 as i64 as u64);
+        crate::pci::serial_debug(",");
+        crate::pci::serial_debug_hex_64(y1 as i64 as u64);
+        crate::pci::serial_debug(",");
+        crate::pci::serial_debug_hex_64(x2 as i64 as u64);
+        crate::pci::serial_debug(",");
+        crate::pci::serial_debug_hex_64(y2 as i64 as u64);
+    }
+    crate::pci::serial_debug(" [/DMGRECTS]\n");
 }
 
