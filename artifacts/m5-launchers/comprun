mkdir -p /run/user/0
export XDG_RUNTIME_DIR=/run/user/0
export COSMIC_BACKEND=kms
export SMITHAY_USE_LEGACY=1
export ICED_BACKEND=tiny-skia
export RUST_LOG=info,zbus=info,smithay=info
export RUST_BACKTRACE=1
unset DISPLAY
unset WAYLAND_DISPLAY
echo COMPRUN-START
brush /usr/bin/dbus-run-session -- cosmic-comp >/tmp/cosmic.log 2>&1 &
echo COMPRUN-BG-PID $!
wait
