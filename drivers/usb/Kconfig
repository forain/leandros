menu "USB"
	depends on USB

config USB_XHCI
	bool "xHCI host controller (+hub)"
	default y

config USB_HID
	tristate "USB HID boot keyboard and mouse"
	default y
	help
	  =m builds modules/usb-hid, loaded by the `usb 03 01 01|02` alias when the enumerator meets a
	  boot keyboard or mouse. Keep =y on any image whose only keyboard is USB.

config USB_STORAGE
	bool "USB mass storage"
	default y

config UVC
	bool "USB video class (webcam)"
	default y

config BT
	bool "Bluetooth (btusb + bthid)"
	default y

config DWC3
	bool "DesignWare USB3 (Pi)"
	depends on ARCH_ARM64
	default y

endmenu
